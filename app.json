{
  "expo": {
    "name": "Zeta",
    "slug": "bigbuys-mobile-app",
    "scheme": "bigbuys",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/zeta_candidate2_1024x1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/zeta_solid_purple_6B2A87_1024x1024_cropped_transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sigmacomputing.bigbuys",
      "icon": "./assets/zeta_candidate2_1024x1024.png",
      "associatedDomains": [
        "applinks:mobile.bigbuys.io"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to enable voice-to-text messaging.",
        "NSSpeechRecognitionUsageDescription": "This app needs speech recognition to convert your voice to text.",
        "NSPhotoLibraryUsageDescription": "This permission is required by app dependencies but is not actively used.",
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sigmacomputing.bigbuys",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mobile.bigbuys.io",
              "pathPrefix": "/auth/verify"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/zeta_solid_purple_6B2A87_1024x1024_cropped_transparent.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 310
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Zeta to access your camera to scan QR codes.",
          "microphonePermission": "Allow Zeta to access your microphone when recording video with the camera.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Zeta to access your microphone for voice-to-text messaging.",
          "speechRecognitionPermission": "Allow Zeta to use speech recognition to convert your voice to text."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e0618c99-4fd5-48b0-b5f4-d97de89707a9"
      }
    }
  }
}
